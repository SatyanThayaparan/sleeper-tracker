# Picky local/Streamlit settings example.
# Copy to .env (gitignored), then UNCOMMENT and replace only the values you use.
# Do not commit real keys, access codes, or private draft URLs.

# Optional: prefill Settings with a Sleeper NBA draft for local testing.
# PICKY_DEFAULT_DRAFT_URL=https://sleeper.com/draft/nba/YOUR_DRAFT_ID

# Optional: paid AI Scout / Ask Picky. BOTH values are required to unlock.
# Keep these private; a visitor with the Scout code can initiate billable AI calls.
# OPENAI_API_KEY=replace-with-your-private-openai-api-key
# PICKY_AI_SCOUT_ACCESS_CODE=replace-with-a-long-private-passphrase
